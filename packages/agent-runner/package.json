{
  "name": "agent-runner",
  "private": true,
  "type": "module",
  "main": "dist/commands/cli.js",
  "types": "dist/commands/cli.d.ts",
  "bin": {
    "agent-runner": "dist/commands/cli.js"
  },
  "scripts": {
    "dev": "tsx src/commands/cli.ts",
    "setup": "node dist/commands/cli.js setup",
    "run": "node dist/commands/cli.js run",
    "watch": "node dist/commands/cli.js watch",
    "once": "node dist/commands/cli.js once",
    "chat": "node dist/commands/cli.js chat",
    "validate": "node dist/commands/cli.js validate",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "shared": "workspace:*",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
