{
  "name": "shared",
  "private": true,
  "type": "module",
  "main": "dist/types.js",
  "types": "dist/types.d.ts",
  "exports": {
    "./types": {
      "types": "./src/types.ts",
      "import": "./dist/types.js"
    },
    "./schemas": {
      "types": "./src/schemas.ts",
      "import": "./dist/schemas.js"
    },
    ".": {
      "types": "./src/types.ts",
      "import": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "latest"
  },
  "devDependencies": {
    "typescript": "latest"
  }
}
